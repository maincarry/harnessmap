ANTHROPIC_API_KEY=sk-ant-...

# Network binding: 127.0.0.1 = localhost only (default); 0.0.0.0 = reachable on the LAN.
HOST=127.0.0.1

# Access control (HTTP Basic auth). Comma-separated user:password pairs.
# If unset, auth is OFF — only do that on localhost.
# HARNESSMAP_USERS=mark:some-strong-password,jacob:another-strong-password

# Optional:
# HARNESSMAP_CHAT_MODEL=claude-sonnet-4-6
# HARNESSMAP_TRANSLATOR_MODEL=claude-haiku-4-5
# HARNESSMAP_DB=/path/to/harnessmap.sqlite
# PORT=8790
